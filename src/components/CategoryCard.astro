---
import Icon from './Icon.astro';
interface Props {
  title: string;
  description: string;
  href: string;
  icon: string;
  count: number;
}
const { title, description, href, icon, count } = Astro.props;
---
<a class="category-card" href={href}>
  <span class="category-icon"><Icon name={icon} size={28} /></span>
  <div>
    <span class="category-count">{count} {count === 1 ? 'herramienta' : 'herramientas'}</span>
    <h3>{title}</h3>
    <p>{description}</p>
  </div>
  <Icon name="arrow-up-right" size={20} />
</a>
