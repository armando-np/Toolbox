---
interface FAQItem { question: string; answer: string; }
interface Props { items: FAQItem[]; title?: string; }
const { items, title = 'Preguntas frecuentes' } = Astro.props;
const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: items.map((item) => ({
    '@type': 'Question',
    name: item.question,
    acceptedAnswer: { '@type': 'Answer', text: item.answer }
  }))
};
---
<section class="content-section faq-section">
  <p class="eyebrow">Respuestas rápidas</p>
  <h2>{title}</h2>
  <div class="faq-list">
    {items.map((item) => (
      <details>
        <summary>{item.question}</summary>
        <p>{item.answer}</p>
      </details>
    ))}
  </div>
</section>
<script type="application/ld+json" set:html={JSON.stringify(faqSchema)}></script>
