---
const pathname = Astro.url.pathname;
const links = [
  { href: '/', label: 'Inicio' },
  { href: '/calculadoras/', label: 'Calculadoras' },
  { href: '/generadores/', label: 'Generadores' },
  { href: '/convertidores/', label: 'Convertidores' },
  { href: '/blog/', label: 'Blog' },
  { href: '/acerca/', label: 'Acerca' },
  { href: '/contacto/', label: 'Contacto' }
];

const isActive = (href: string) =>
  href === '/' ? pathname === '/' : pathname.startsWith(href);
---
<header class="site-header">
  <div class="container nav-wrap">
    <a class="brand" href="/" aria-label="ToolboxMX, inicio">
      <span class="brand-mark">T</span>
      <span>ToolboxMX</span>
    </a>

    <button class="menu-button" type="button" aria-expanded="false" aria-controls="main-nav">
      Menu
    </button>

    <nav id="main-nav" class="main-nav" aria-label="Navegacion principal">
      {links.map((link) => (
        <a href={link.href} aria-current={isActive(link.href) ? 'page' : undefined}>
          {link.label}
        </a>
      ))}
    </nav>
  </div>
</header>

<script>
  const button = document.querySelector<HTMLButtonElement>('.menu-button');
  const nav = document.querySelector<HTMLElement>('.main-nav');

  button?.addEventListener('click', () => {
    const open = button.getAttribute('aria-expanded') === 'true';
    button.setAttribute('aria-expanded', String(!open));
    nav?.classList.toggle('is-open', !open);
  });
</script>
