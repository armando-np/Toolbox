---
interface Props { compact?: boolean; }
const { compact = false } = Astro.props;
---
<span class="logo" aria-hidden="true">
  <svg viewBox="0 0 42 42" width="38" height="38">
    <defs>
      <linearGradient id="logo-gradient" x1="3" y1="3" x2="39" y2="39" gradientUnits="userSpaceOnUse">
        <stop stop-color="#7c6cff"/>
        <stop offset="1" stop-color="#3b82f6"/>
      </linearGradient>
    </defs>
    <rect x="2" y="2" width="38" height="38" rx="12" fill="url(#logo-gradient)"/>
    <path d="M12 12h18v5h-6.2v14h-5.6V17H12v-5Z" fill="white"/>
    <path d="M27.2 23.5 31 31h-5.8l-2.1-4.6 4.1-2.9Z" fill="#dbeafe"/>
  </svg>
  {!compact && <span class="logo-wordmark">Toolbox<span>MX</span></span>}
</span>
