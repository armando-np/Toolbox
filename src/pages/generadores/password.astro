---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ToolShell from '../../components/ToolShell.astro';
---
<BaseLayout
  title="Generador de contrasenas"
  description="Genera contrasenas aleatorias y configurables directamente en tu navegador."
>
  <ToolShell
    title="Generador de contrasenas"
    description="Configura longitud y tipos de caracteres. La contrasena se genera localmente con Web Crypto."
  >
    <form id="password-form" data-tool="password">
      <div class="form-grid">
        <div class="field field-full">
          <label for="length">Longitud: <output id="length-output">20</output></label>
          <input id="length" name="length" type="range" min="8" max="64" value="20" />
        </div>
        <div class="field field-full">
          <span>Caracteres incluidos</span>
          <div class="checkbox-grid">
            <label><input name="lowercase" type="checkbox" checked /> Minusculas</label>
            <label><input name="uppercase" type="checkbox" checked /> Mayusculas</label>
            <label><input name="numbers" type="checkbox" checked /> Numeros</label>
            <label><input name="symbols" type="checkbox" checked /> Simbolos</label>
          </div>
        </div>
      </div>
      <div class="actions">
        <button class="button" type="submit">Generar</button>
        <button id="copy-password" data-track="password_copy" class="button button-secondary" type="button">Copiar</button>
      </div>
    </form>
    <p id="password-output" class="output-box" aria-live="polite">Pulsa Generar.</p>
  </ToolShell>
</BaseLayout>

<script>
  const form = document.querySelector<HTMLFormElement>('#password-form');
  const lengthInput = document.querySelector<HTMLInputElement>('#length');
  const lengthOutput = document.querySelector<HTMLOutputElement>('#length-output');
  const passwordOutput = document.querySelector<HTMLElement>('#password-output');
  const copyButton = document.querySelector<HTMLButtonElement>('#copy-password');

  const sets = {
    lowercase: 'abcdefghijkmnopqrstuvwxyz',
    uppercase: 'ABCDEFGHJKLMNPQRSTUVWXYZ',
    numbers: '23456789',
    symbols: '!@#$%&*+-_=?.'
  };

  const secureIndex = (max: number) => {
    const array = new Uint32Array(1);
    crypto.getRandomValues(array);
    return array[0] % max;
  };

  const generate = (characters: string, length: number) =>
    Array.from({ length }, () => characters[secureIndex(characters.length)]).join('');

  lengthInput?.addEventListener('input', () => {
    if (lengthOutput) lengthOutput.value = lengthInput.value;
  });

  form?.addEventListener('submit', (event) => {
    event.preventDefault();
    const data = new FormData(event.currentTarget as HTMLFormElement);
    const selected = Object.entries(sets)
      .filter(([key]) => data.get(key) === 'on')
      .map(([, value]) => value)
      .join('');

    if (!selected) {
      if (passwordOutput) passwordOutput.textContent = 'Selecciona al menos un tipo de caracter.';
      return;
    }

    if (passwordOutput) {
      passwordOutput.textContent = generate(selected, Number(data.get('length')));
    }
  });

  copyButton?.addEventListener('click', async () => {
    const text = passwordOutput?.textContent ?? '';
    if (!text || text === 'Pulsa Generar.') return;
    await navigator.clipboard.writeText(text);
    copyButton.textContent = 'Copiado';
    window.setTimeout(() => { copyButton.textContent = 'Copiar'; }, 1200);
  });
</script>
