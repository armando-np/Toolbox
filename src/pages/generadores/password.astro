---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ToolShell from '../../components/ToolShell.astro';
import FAQ from '../../components/FAQ.astro';
import CopyButton from '../../components/CopyButton.astro';
const faqs = [
  { question: '¿La contraseña se envía a un servidor?', answer: 'No. La generación utiliza la API Web Crypto del navegador y el resultado permanece en tu dispositivo.' },
  { question: '¿Qué longitud conviene usar?', answer: 'Para cuentas importantes, prioriza contraseñas largas y únicas. El valor adecuado depende de las reglas del servicio y de tu modelo de riesgo.' },
  { question: '¿Debo reutilizarla en varias cuentas?', answer: 'No. Una contraseña distinta por servicio limita el impacto de una filtración.' }
];
---
<BaseLayout title="Generador de contraseñas seguras" description="Genera contraseñas aleatorias y configurables con Web Crypto. El resultado se crea localmente en tu navegador." jsonLd={{ '@context': 'https://schema.org', '@type': 'WebApplication', name: 'Generador de contraseñas', applicationCategory: 'SecurityApplication', operatingSystem: 'Web', offers: { '@type': 'Offer', price: '0', priceCurrency: 'MXN' }, url: Astro.url.href }}>
  <ToolShell toolId="password" title="Generador de contraseñas" description="Crea una contraseña aleatoria, ajusta su longitud y decide qué tipos de caracteres incluir." categoryHref="/generadores/" categoryLabel="Generadores">
    <div slot="tool">
      <form id="password-form" data-tool="password">
        <div class="form-grid">
          <div class="field field-full">
            <label for="length">Longitud: <output id="length-output">20</output> caracteres</label>
            <input id="length" name="length" type="range" min="8" max="64" value="20" />
          </div>
          <div class="field field-full">
            <span>Tipos de caracteres</span>
            <div class="checkbox-grid">
              <label><input name="lowercase" type="checkbox" checked /> Minúsculas</label>
              <label><input name="uppercase" type="checkbox" checked /> Mayúsculas</label>
              <label><input name="numbers" type="checkbox" checked /> Números</label>
              <label><input name="symbols" type="checkbox" checked /> Símbolos</label>
            </div>
          </div>
        </div>
        <div class="actions"><button class="button" type="submit">Generar contraseña</button><CopyButton target="#password-output" /></div>
      </form>
      <p id="password-output" class="output-box" aria-live="polite">Selecciona tus opciones y pulsa Generar contraseña.</p>
      <div class="password-strength" aria-live="polite"><div class="strength-track"><div id="strength-bar" class="strength-bar"></div></div><span id="strength-copy" class="strength-copy">La estimación aparecerá después de generar.</span></div>
    </div>
    <div slot="content">
      <h2>Buenas prácticas</h2><ul><li>Usa una contraseña única para cada servicio.</li><li>Prioriza la longitud y la aleatoriedad.</li><li>Guárdala en un administrador de contraseñas confiable.</li><li>Activa autenticación multifactor cuando esté disponible.</li></ul>
      <h2>Cómo funciona la generación</h2><p>La herramienta obtiene valores aleatorios mediante <code>crypto.getRandomValues()</code>, selecciona caracteres de los conjuntos elegidos y mezcla el resultado. Se garantiza al menos un carácter de cada conjunto activo.</p>
      <FAQ items={faqs} />
    </div>
  </ToolShell>
</BaseLayout>
<script>
  const form = document.querySelector<HTMLFormElement>('#password-form');
  const lengthInput = document.querySelector<HTMLInputElement>('#length');
  const lengthOutput = document.querySelector<HTMLOutputElement>('#length-output');
  const passwordOutput = document.querySelector<HTMLElement>('#password-output');
  const strengthBar = document.querySelector<HTMLElement>('#strength-bar');
  const strengthCopy = document.querySelector<HTMLElement>('#strength-copy');
  const sets: Record<string, string> = {
    lowercase: 'abcdefghijkmnopqrstuvwxyz',
    uppercase: 'ABCDEFGHJKLMNPQRSTUVWXYZ',
    numbers: '23456789',
    symbols: '!@#$%&*+-_=?.'
  };
  const randomInt = (max: number) => {
    if (max <= 0) throw new Error('max debe ser positivo');
    const limit = Math.floor(0x100000000 / max) * max;
    const value = new Uint32Array(1);
    do crypto.getRandomValues(value); while (value[0] >= limit);
    return value[0] % max;
  };
  const pick = (characters: string) => characters[randomInt(characters.length)];
  const shuffle = (characters: string[]) => {
    for (let index = characters.length - 1; index > 0; index -= 1) {
      const target = randomInt(index + 1);
      [characters[index], characters[target]] = [characters[target], characters[index]];
    }
    return characters;
  };
  const updateStrength = (length: number, poolSize: number) => {
    const bits = length * Math.log2(poolSize);
    const percent = Math.min(100, Math.max(8, bits / 1.2));
    const label = bits < 50 ? 'Básica' : bits < 75 ? 'Buena' : bits < 100 ? 'Fuerte' : 'Muy fuerte';
    if (strengthBar) strengthBar.style.width = `${percent}%`;
    if (strengthCopy) strengthCopy.textContent = `${label} · entropía teórica aproximada: ${Math.round(bits)} bits`;
  };
  lengthInput?.addEventListener('input', () => { if (lengthOutput) lengthOutput.value = lengthInput.value; });
  form?.addEventListener('submit', (event) => {
    event.preventDefault();
    if (!form.reportValidity()) return;
    const data = new FormData(form);
    const activeSets = Object.entries(sets).filter(([key]) => data.get(key) === 'on').map(([, value]) => value);
    if (!activeSets.length) { if (passwordOutput) passwordOutput.textContent = 'Selecciona al menos un tipo de carácter.'; return; }
    const length = Math.max(activeSets.length, Number(data.get('length')));
    const pool = activeSets.join('');
    const password = activeSets.map(pick);
    while (password.length < length) password.push(pick(pool));
    const result = shuffle(password).join('');
    if (passwordOutput) passwordOutput.textContent = result;
    updateStrength(length, pool.length);
    window.toolboxTrack?.('generation_completed', { tool_name: 'password', length });
  });
</script>
