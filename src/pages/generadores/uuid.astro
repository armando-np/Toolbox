---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ToolShell from '../../components/ToolShell.astro';
import FAQ from '../../components/FAQ.astro';
import CopyButton from '../../components/CopyButton.astro';
const faqs = [
  { question: '¿Qué es un UUID v4?', answer: 'Es un identificador de 128 bits cuya versión 4 se genera principalmente con valores aleatorios.' },
  { question: '¿Puede repetirse?', answer: 'La probabilidad de colisión es extremadamente baja, pero ningún esquema aleatorio ofrece una garantía matemática absoluta de unicidad global.' },
  { question: '¿Se guardan los UUID generados?', answer: 'No. Se crean en tu navegador y desaparecen al recargar la página, salvo que los copies o guardes.' }
];
---
<BaseLayout title="Generador de UUID v4" description="Genera uno o varios UUID v4 con Web Crypto y cópialos en un clic. Todo ocurre en tu navegador." jsonLd={{ '@context': 'https://schema.org', '@type': 'WebApplication', name: 'Generador de UUID v4', applicationCategory: 'DeveloperApplication', operatingSystem: 'Web', offers: { '@type': 'Offer', price: '0', priceCurrency: 'MXN' }, url: Astro.url.href }}>
  <ToolShell toolId="uuid" title="Generador de UUID v4" description="Genera identificadores compatibles con UUID v4 mediante la API criptográfica del navegador." categoryHref="/generadores/" categoryLabel="Generadores">
    <div slot="tool">
      <form id="uuid-form" data-tool="uuid">
        <div class="form-grid"><div class="field"><label for="uuid-count">Cantidad</label><input id="uuid-count" name="count" type="number" inputmode="numeric" min="1" max="100" value="5" required /></div></div>
        <div class="actions"><button class="button" type="submit">Generar UUID</button><CopyButton target="#uuid-output" label="Copiar todos" /></div>
      </form>
      <pre id="uuid-output" class="output-box" aria-live="polite">Pulsa Generar UUID.</pre>
    </div>
    <div slot="content">
      <h2>Formato</h2><p>Un UUID v4 suele representarse en cinco grupos hexadecimales separados por guiones, por ejemplo <code>xxxxxxxx-xxxx-4xxx-yxxx-xxxxxxxxxxxx</code>.</p>
      <h2>Usos frecuentes</h2><div class="info-grid"><article class="info-card"><strong>Bases de datos</strong><p>Identificadores que pueden generarse sin un contador central.</p></article><article class="info-card"><strong>Pruebas</strong><p>Datos únicos para fixtures, solicitudes y entornos temporales.</p></article><article class="info-card"><strong>Sistemas distribuidos</strong><p>Claves creadas por múltiples clientes con bajo riesgo de colisión.</p></article><article class="info-card"><strong>Archivos y objetos</strong><p>Nombres opacos que no dependen de datos personales.</p></article></div>
      <FAQ items={faqs} />
    </div>
  </ToolShell>
</BaseLayout>
<script>
  const form = document.querySelector<HTMLFormElement>('#uuid-form');
  const output = document.querySelector<HTMLElement>('#uuid-output');
  const createUuid = () => {
    if (typeof crypto.randomUUID === 'function') return crypto.randomUUID();
    const bytes = crypto.getRandomValues(new Uint8Array(16));
    bytes[6] = (bytes[6] & 0x0f) | 0x40;
    bytes[8] = (bytes[8] & 0x3f) | 0x80;
    const hex = [...bytes].map((byte) => byte.toString(16).padStart(2, '0')).join('');
    return `${hex.slice(0, 8)}-${hex.slice(8, 12)}-${hex.slice(12, 16)}-${hex.slice(16, 20)}-${hex.slice(20)}`;
  };
  form?.addEventListener('submit', (event) => {
    event.preventDefault();
    if (!form.reportValidity()) return;
    const count = Math.min(100, Math.max(1, Number(new FormData(form).get('count'))));
    const uuids = Array.from({ length: count }, createUuid);
    if (output) output.textContent = uuids.join('\n');
    window.toolboxTrack?.('generation_completed', { tool_name: 'uuid', count });
  });
</script>
