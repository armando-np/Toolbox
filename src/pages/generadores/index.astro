---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/PageHeader.astro';
import ToolCard from '../../components/ToolCard.astro';
import { tools } from '../../data/tools';
const generators = tools.filter((tool) => tool.category === 'Generadores');
---
<BaseLayout
  title="Generadores"
  description="Generadores gratuitos de codigos QR, contrasenas y UUID."
>
  <PageHeader
    eyebrow="Categoria"
    title="Generadores"
    description="Crea recursos utiles desde tu navegador sin registrar una cuenta."
  />
  <section class="container section">
    <div class="tool-grid">
      {generators.map((tool) => <ToolCard {...tool} />)}
    </div>
  </section>
</BaseLayout>
