---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ToolShell from '../../components/ToolShell.astro';
import FAQ from '../../components/FAQ.astro';
const faqs = [
  { question: '¿La mensualidad incluye seguros y comisiones?', answer: 'No. El cálculo utiliza únicamente monto financiado, tasa anual y plazo. Una oferta real puede incluir seguros, comisiones, impuestos y otros cargos.' },
  { question: '¿Qué pasa si la tasa es de 0%?', answer: 'La calculadora divide el capital entre el número de pagos mensuales.' },
  { question: '¿El resultado es una cotización?', answer: 'No. Es una estimación matemática para comparar escenarios; la institución financiera define las condiciones finales.' }
];
---
<BaseLayout title="Calculadora de hipoteca" description="Calcula la mensualidad aproximada, intereses y costo total de una hipoteca con enganche, tasa y plazo." jsonLd={{ '@context': 'https://schema.org', '@type': 'WebApplication', name: 'Calculadora de hipoteca', applicationCategory: 'FinanceApplication', operatingSystem: 'Web', offers: { '@type': 'Offer', price: '0', priceCurrency: 'MXN' }, url: Astro.url.href }}>
  <ToolShell toolId="hipoteca" title="Calculadora de hipoteca" description="Compara escenarios de crédito con precio, enganche, tasa anual y plazo." note="La estimación no incluye CAT, seguros, comisiones, impuestos ni cambios de tasa. Solicita siempre una tabla de amortización oficial." categoryHref="/calculadoras/" categoryLabel="Calculadoras">
    <div slot="tool">
      <form id="mortgage-form" data-tool="hipoteca" novalidate>
        <div class="form-grid">
          <div class="field"><label for="property-price">Precio de la propiedad</label><div class="input-prefix"><span>$</span><input id="property-price" name="price" type="number" inputmode="decimal" min="1" step="1000" placeholder="2500000" required /></div></div>
          <div class="field"><label for="down-payment">Enganche</label><div class="input-prefix"><span>$</span><input id="down-payment" name="downPayment" type="number" inputmode="decimal" min="0" step="1000" value="500000" /></div></div>
          <div class="field"><label for="annual-rate">Tasa anual (%)</label><input id="annual-rate" name="annualRate" type="number" inputmode="decimal" min="0" max="100" step="0.01" placeholder="10.5" required /></div>
          <div class="field"><label for="years">Plazo (años)</label><input id="years" name="years" type="number" inputmode="numeric" min="1" max="50" step="1" value="20" required /></div>
        </div>
        <div class="actions"><button class="button" type="submit">Calcular mensualidad</button><button class="button button-secondary" type="reset">Restablecer</button></div>
      </form>
      <section id="mortgage-result" class="result" hidden aria-live="polite">
        <span class="result-kicker">Mensualidad aproximada</span><p id="monthly-payment" class="result-value"></p>
        <div class="result-details"><span id="loan-amount"></span><span id="total-payment"></span><span id="total-interest"></span></div>
      </section>
    </div>
    <div slot="content">
      <h2>Qué calcula</h2><p>La herramienta usa la fórmula de una anualidad con pagos mensuales fijos. Primero resta el enganche al precio para obtener el capital financiado y después aplica la tasa mensual durante el plazo elegido.</p>
      <h2>Cómo comparar escenarios</h2><div class="info-grid"><article class="info-card"><strong>Mayor enganche</strong><p>Reduce el capital financiado y normalmente el interés total.</p></article><article class="info-card"><strong>Menor plazo</strong><p>Aumenta la mensualidad, pero puede disminuir significativamente el interés acumulado.</p></article><article class="info-card"><strong>Menor tasa</strong><p>Reduce mensualidad e intereses, aunque debes comparar el CAT y las comisiones.</p></article><article class="info-card"><strong>Gastos adicionales</strong><p>Considera avalúo, escrituración, seguros, mantenimiento e impuestos.</p></article></div>
      <FAQ items={faqs} />
    </div>
  </ToolShell>
</BaseLayout>
<script>
  const form = document.querySelector<HTMLFormElement>('#mortgage-form');
  const result = document.querySelector<HTMLElement>('#mortgage-result');
  const monthlyOutput = document.querySelector<HTMLElement>('#monthly-payment');
  const loanOutput = document.querySelector<HTMLElement>('#loan-amount');
  const totalOutput = document.querySelector<HTMLElement>('#total-payment');
  const interestOutput = document.querySelector<HTMLElement>('#total-interest');
  const mxn = new Intl.NumberFormat('es-MX', { style: 'currency', currency: 'MXN', maximumFractionDigits: 0 });
  form?.addEventListener('submit', (event) => {
    event.preventDefault(); if (!form.reportValidity()) return;
    const data = new FormData(form); const price = Number(data.get('price')); const downPayment = Number(data.get('downPayment')); const annualRate = Number(data.get('annualRate')); const years = Number(data.get('years'));
    if (downPayment >= price) { form.querySelector<HTMLInputElement>('#down-payment')?.setCustomValidity('El enganche debe ser menor que el precio.'); form.reportValidity(); return; }
    form.querySelector<HTMLInputElement>('#down-payment')?.setCustomValidity('');
    const principal = price - downPayment; const payments = years * 12; const monthlyRate = annualRate / 100 / 12;
    const monthly = monthlyRate === 0 ? principal / payments : principal * (monthlyRate * ((1 + monthlyRate) ** payments)) / (((1 + monthlyRate) ** payments) - 1);
    const total = monthly * payments; const interest = total - principal;
    if (monthlyOutput) monthlyOutput.textContent = mxn.format(monthly); if (loanOutput) loanOutput.textContent = `Monto financiado: ${mxn.format(principal)}`; if (totalOutput) totalOutput.textContent = `Total estimado de pagos: ${mxn.format(total)}`; if (interestOutput) interestOutput.textContent = `Interés estimado: ${mxn.format(interest)}`;
    if (result) { result.hidden = false; result.scrollIntoView({ behavior: 'smooth', block: 'nearest' }); }
    window.toolboxTrack?.('calculation_completed', { tool_name: 'hipoteca', term_years: years });
  });
  form?.addEventListener('reset', () => { if (result) result.hidden = true; form.querySelector<HTMLInputElement>('#down-payment')?.setCustomValidity(''); });
</script>
