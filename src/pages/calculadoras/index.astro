---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/PageHeader.astro';
import ToolCard from '../../components/ToolCard.astro';
import { getToolsByCategory } from '../../data/tools';
const categoryTools = getToolsByCategory('Calculadoras');
---
<BaseLayout title="Calculadoras gratuitas" description="Calculadoras gratuitas de salud, finanzas y trabajo con resultados claros y uso inmediato desde el navegador.">
  <PageHeader eyebrow="Categoría" title="Calculadoras" description="Realiza estimaciones de salud, finanzas y trabajo con formularios claros, resultados inmediatos y explicaciones de cada cálculo." breadcrumbs={[{ label: 'Calculadoras' }]} />
  <section class="section">
    <div class="container">
      <div class="tool-grid">{categoryTools.map((tool) => <ToolCard {...tool} />)}</div>
    </div>
  </section>
</BaseLayout>
