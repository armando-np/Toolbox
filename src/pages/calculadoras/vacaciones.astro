---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ToolShell from '../../components/ToolShell.astro';
---
<BaseLayout
  title="Calculadora de vacaciones"
  description="Estima dias de vacaciones, pago y prima vacacional con parametros configurables."
>
  <ToolShell
    title="Calculadora de vacaciones"
    description="Calcula una estimacion del pago correspondiente a tus dias de vacaciones."
    note="La legislacion y las politicas laborales pueden cambiar. Verifica los dias y porcentajes aplicables en tu contrato y con una fuente oficial."
  >
    <form id="vacation-form" data-tool="vacaciones">
      <div class="form-grid">
        <div class="field">
          <label for="daily-salary">Salario diario (MXN)</label>
          <input id="daily-salary" name="dailySalary" type="number" min="0" step="0.01" required />
        </div>
        <div class="field">
          <label for="days">Dias de vacaciones</label>
          <input id="days" name="days" type="number" min="1" max="365" step="1" value="12" required />
        </div>
        <div class="field">
          <label for="premium">Prima vacacional (%)</label>
          <input id="premium" name="premium" type="number" min="0" max="500" step="0.01" value="25" required />
        </div>
        <div class="field">
          <label for="other">Otros pagos (MXN)</label>
          <input id="other" name="other" type="number" min="0" step="0.01" value="0" />
        </div>
      </div>
      <div class="actions">
        <button class="button" type="submit">Calcular</button>
        <button class="button button-secondary" type="reset">Limpiar</button>
      </div>
    </form>

    <section id="vacation-result" class="result" hidden aria-live="polite">
      <h2>Total estimado</h2>
      <p id="vacation-total" class="result-value"></p>
      <div class="result-details">
        <span id="vacation-pay"></span>
        <span id="vacation-premium"></span>
      </div>
    </section>
  </ToolShell>
</BaseLayout>

<script>
  const form = document.querySelector<HTMLFormElement>('#vacation-form');
  const result = document.querySelector<HTMLElement>('#vacation-result');
  const totalOutput = document.querySelector<HTMLElement>('#vacation-total');
  const payOutput = document.querySelector<HTMLElement>('#vacation-pay');
  const premiumOutput = document.querySelector<HTMLElement>('#vacation-premium');
  const mxn = new Intl.NumberFormat('es-MX', { style: 'currency', currency: 'MXN' });

  form?.addEventListener('submit', (event) => {
    event.preventDefault();
    const data = new FormData(event.currentTarget as HTMLFormElement);
    const dailySalary = Number(data.get('dailySalary'));
    const days = Number(data.get('days'));
    const premiumRate = Number(data.get('premium')) / 100;
    const other = Number(data.get('other'));

    const vacationPay = dailySalary * days;
    const premium = vacationPay * premiumRate;
    const total = vacationPay + premium + other;

    if (totalOutput) totalOutput.textContent = mxn.format(total);
    if (payOutput) payOutput.textContent = `Pago por vacaciones: ${mxn.format(vacationPay)}`;
    if (premiumOutput) premiumOutput.textContent = `Prima vacacional: ${mxn.format(premium)}`;
    if (result) result.hidden = false;
  });

  form?.addEventListener('reset', () => {
    if (result) result.hidden = true;
  });
</script>
